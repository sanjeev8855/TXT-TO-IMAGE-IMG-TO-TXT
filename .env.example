# ========================================================
# MULTIMODAL AI & EXPLAINABLE FORENSICS CONFIGURATION
# ========================================================

# 1. PRIMARY VISION: Google Gemini Vision
# (Supports GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash

# 2. PRIMARY IMAGE -> TEXT: Llama 3.2 90B Vision Instruct
# Configure your token from Groq, Together AI, OpenRouter, or Hugging Face
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.2-90b-vision-instruct
# Optional custom base URL (e.g., https://api.groq.com/openai/v1 or https://api.together.xyz/v1)
LLAMA_API_BASE=

# 3. FALLBACK IMAGE -> TEXT & REASONING: Kimi K3
# Configure your Moonshot / Kimi API key (or MOONSHOT_API_KEY)
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_API_BASE=https://api.moonshot.cn/v1

# 4. TEXT -> IMAGE GENERATION: NVIDIA GenAI / FLUX.1-dev & Diffusion
IMAGE_GENERATION_PROVIDER=nvidia
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=black-forest-labs/flux.1-dev

# 5. TESTING & SIMULATION CONTROLS
# Set to 'true' to force Llama failure and verify automatic Kimi K3 fallback
FORCE_LLAMA_FAILURE=false
FORCE_KIMI_FAILURE=false

# 6. SERVER SETTINGS
HOST=127.0.0.1
PORT=8000
DEBUG=True
